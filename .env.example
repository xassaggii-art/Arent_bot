# Telegram: создайте бота через @BotFather и вставьте токен
BOT_TOKEN=

# Кому слать служебные ошибки (ваш numeric Telegram user id)
ADMIN_CHAT_ID=

# FlareSolverr обязателен для list.am (Cloudflare)
FLARESOLVERR_URL=http://localhost:8191
FLARESOLVERR_MAX_TIMEOUT_MS=90000

# Интервал опроса источников (секунды)
POLL_INTERVAL_SEC=180

# Путь к SQLite
DATABASE_PATH=./data/bot.sqlite3

# Facebook (экспериментально): включить мониторинг Marketplace
FACEBOOK_ENABLED=false

# Опционально: cookie строка для facebook.com (нужна для большинства запросов)
FACEBOOK_COOKIE=
